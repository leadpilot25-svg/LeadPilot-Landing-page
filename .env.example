# ==============================================================================
# LEADPILOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Target Deployment Environment
# Options:
#   'landing' - Public Landing Website: Standalone client landing page with Google Business Profile
#               info, lead capture form, WhatsApp integration. Zero dev or CRM controls.
#   'crm'     - Separate Client CRM: Customer-facing CRM with secure login/logout, lead dashboard,
#               follow-up reminders, WhatsApp action buttons. Zero dev controls or landing preview.
#   'dev'     - Internal Development Environment: Master suite with Dev Mode, Client Mode preview,
#               Config Editor Drawer, Code Exporter.
VITE_APP_TARGET=dev

# Scoped Client Identifier (e.g. demo-tarot, client-hvac, client-01)
VITE_CLIENT_ID=demo-tarot

# Optional Google Apps Script / Google Sheets backend webhook URL
VITE_FORM_ENDPOINT=https://script.google.com/macros/s/AKfycbx.../exec

# Optional custom credentials for CRM login (overrides default client demo accounts)
# VITE_CRM_USER=client@example.com
# VITE_CRM_PASSWORD=SecurePassword2026!
